  "scripts": {
    "check": "npm run lint && npm test && npm run build",
    "format": "prettier --write . && eslint --fix .",
    "lint": "shellcheck -x -P SCRIPTDIR tests/container/stock tests/container/check-stock tests/container/node tests/container/e2e && markdownlint-cli2 && node scripts/typecheck.ts && prettier --check . && eslint --max-warnings 0 .",
