{
  "name": "game-kit-repo",
  "description": "The gate and sync script for @andornaut/game-kit, which lives in kit/.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "check": "tsc",
    "format": "prettier --write . && eslint --fix .",
